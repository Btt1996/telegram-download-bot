# Copy this file to .env and fill in your own values. Never commit .env.
# Get the token from @BotFather in Telegram. This must be a DIFFERENT bot
# from the one the app uses for Telegram sync.

# Bot token from @BotFather (required)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Channel the bot posts MP3s to: @channelusername or the -100... id
# (required). Create a channel, add the bot as admin with permission
# to post messages.
CHANNEL_ID=@yourchannel

# Spotify credentials for playlist/track links (optional — case 2 is
# disabled without them). Free from https://developer.spotify.com
# (create an app, copy its Client ID and Client Secret).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube cookies (optional — only needed when YouTube blocks downloads
# with "Sign in to confirm you're not a bot"). Base64 of a cookies.txt
# exported from a logged-in browser; see the README section
# "YouTube cookies". Never commit real cookies.
YOUTUBE_COOKIES_B64=
